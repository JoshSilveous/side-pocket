# Normalize all text files to LF in the repo; check out native on each OS.
# Kills the Windows(CRLF)/Mac(LF) churn across your two machines.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
